e.i(841983),i=e.i(728925),r=e.i(448504);let n="https://support.apple.com/102606",s="https://support.apple.com/apple-account",o="https://developer.apple.com/programs/",a="/pricing",l="text-white/70 underline decoration-white/30 underline-offset-4 transition-colors hover:text-white motion-reduce:transition-none";function d({href:e,children:r}){return e.startsWith("http")?(0,t.jsx)("a",{href:e,target:"_blank",rel:"noopener noreferrer",className:l,children:r}):(0,t.jsx)(i.default,{href:e,className:l,children:r})}let c={en:{title:"Frequently asked questions",seeMore:"See more questions",items:[{question:"Which subscription do I need to use the Rork Max App?",answer:(0,t.jsxs)(t.Fragment,{children:["You can build apps on any Rork plan. The Rork Max iPhone app comes with the Rork Max plan, starting at $200/month, see ",(0,t.jsx)(d,{href:a,children:"pricing"}),". On a Pro plan you can also try Rork Max for free before upgrading."]})},{question:"Does it work only on iPhone?",answer:"Yes, Rork Max is an iPhone app. It needs iOS 18 or later. You can check your version in Settings → General → About."},{question:"Do I need a Mac or a Windows PC?",answer:"You'll need a Mac for the initial install: open the installer in Chrome or Edge (Safari and Firefox can't talk to iPhones over USB). Windows isn't supported yet. The good news: you only need the computer once, and after that everything lives on your iPhone."},{question:"Do I need to install anything on my computer?",answer:"Nope. There's nothing to download, the whole installer runs in your browser. Just plug in your iPhone with a USB cable and follow the four steps on the install page."},{question:"Is it safe to sign in with my Apple Account?",answer:"Yes. Your Apple credentials, certificates, and pairing data stay in your browser, and app signing happens locally on your machine. Nothing is sent to Rork's servers."},{question:"Do I need a paid Apple Developer account?",answer:"No, both free and paid Apple Developer accounts work. The only difference: a free account lets you keep up to 3 sideloaded apps installed at a time, while a paid membership removes that limit."},{question:"Do I need an original cable?",answer:"Preferably, yes: the one that came with your iPhone, or any MFi-certified cable. It must be a data cable, not a charge-only one. With uncertified cables the connection can drop mid-install, and we can't guarantee it will work."},{question:"What happened to Rork Companion?",answer:"If you're on Chrome or Edge on a Mac, you don't need Companion anymore. Everything from installing Rork Max to putting your apps on your iPhone now happens in the browser and inside the app itself. Companion sticks around for browsers the installer doesn't support yet."},{question:"Can I really install full apps to my iPhone from Rork Max?",answer:"Yes, really. The apps you build land on your Home Screen as real iOS apps. You can launch them like anything else and test Widgets, Camera, Dynamic Island, and other native features right away."},{question:"Can I preview web projects too?",answer:"Yes. Rork Max can preview both native Swift apps and web projects. Swift apps run natively and can be installed to your Home Screen, which is what unlocks Widgets, Live Activities, ARKit, HealthKit, and other Apple features."},{question:"Can I publish to the App Store from my phone?",answer:"Yes. Icons, screenshots, preflight checks, TestFlight, and App Store submission all happen right from the chat."},{question:"How do updates work?",answer:"Rork Max updates itself over the air. Install it once, and new features simply arrive the next time you open the app. No cable, no reinstalling."},{question:"Why do I see multiple Rork Max apps on my iPhone?",answer:"Each install is tied to the Apple Developer team you signed with, so installs from different Apple accounts or teams show up as separate apps. Reinstalling with the same Rork account and the same Apple team always replaces the existing app instead of adding a new one. Feel free to delete the copies you don't use: a free Apple Developer account only allows 3 sideloaded apps at a time."},{question:"I'm not receiving the SMS verification code from Apple",answer:(0,t.jsxs)(t.Fragment,{children:["Instead of waiting for the SMS, grab the code from a trusted device: on any iPhone, iPad, or Mac where you're already signed in, go to Settings → your name → Sign-In & Security → Get Verification Code. Apple's ",(0,t.jsx)(d,{href:n,children:"verification code guide"})," walks through every option. Still stuck? Reach ",(0,t.jsx)(d,{href:s,children:"Apple Support for Apple Account"})," ","(SMS delivery is on their side)."]})},{question:"The app won't launch after installing",answer:(0,t.jsxs)(t.Fragment,{children:["Two things to check. First, trust the developer on your iPhone: Settings → General → VPN & Device Management → tap your account → Trust. Second, make sure Developer Mode is on: Settings → Privacy & Security → Developer Mode. And if you're on a free Apple Developer account, Apple allows only 3 sideloaded apps at a time, so you may have hit that limit. The paid"," ",(0,t.jsx)(d,{href:o,children:"Apple Developer Program"})," ($99/year) removes it."]})},{question:"How do I use it after installation?",answer:"Just open Rork Max whenever inspiration strikes. All your apps, sessions, and their latest state are waiting right there."}]},ja:{title:"よくある質問",seeMore:"もっと見る",items:[{question:"Rork Maxアプリを使うにはどのプランが必要ですか？",answer:(0,t.jsxs)(t.Fragment,{children:["アプリ作成自体はどのRorkプランでも可能です。Rork MaxのiPhoneアプリはRork Maxプラン（月額$200〜）に 含まれます。詳しくは",(0,t.jsx)(d,{href:a,children:"料金ページ"}),"をご覧ください。Proプランなら、アップグレード前にRork Maxを無料で試せます。"]})},{question:"iPhoneでしか使えませんか？",answer:"はい、Rork MaxはiPhoneアプリです。iOS 18以降が必要です。バージョンは 設定 → 一般 → 情報 で確認できます。"},{question:"MacとWindowsのどちらが必要ですか？",answer:"最初のインストールにはMacが必要です。ChromeまたはEdgeでインストーラーを開いてください（SafariとFirefoxはUSB経由でiPhoneと通信できません）。Windowsはまだサポートされていません。パソコンが必要なのは最初の一度だけで、その後はすべてiPhoneで完結します。"},{question:"パソコンに何かインストールする必要はありますか？",answer:"いいえ、何もダウンロードする必要はありません。インストーラーはすべてブラウザ内で動きます。iPhoneをUSBケーブルでつないで、インストールページの4つの手順に従うだけです。"},{question:"Apple Accountでサインインしても安全ですか？",answer:"はい。Apple認証情報、証明書、ペアリング情報はブラウザ内に保存され、署名もお使いのマシン上でローカルに実行されます。Rorkのサーバーには送信されません。"},{question:"有料のApple Developerアカウントが必要ですか？",answer:"いいえ、無料・有料どちらのApple Developerアカウントでも動作します。違いは1つだけ：無料アカウントは同時にインストールできるアプリが3つまでで、有料メンバーシップならその制限がなくなります。"},{question:"純正ケーブルが必要ですか？",answer:"できればiPhone付属のケーブルか、MFi認証済みのものをお使いください。充電専用ではなくデータ通信対応のケーブルが必要です。認証されていないケーブルではインストール中に接続が切れることがあり、動作は保証できません。"},{question:"Rork Companionはどうなりましたか？",answer:"MacのChromeまたはEdgeをお使いなら、Companionはもう必要ありません。Rork Maxのインストールからアプリの転送まで、すべてブラウザとアプリ内で完結します。インストーラーがまだサポートしていないブラウザではCompanionを引き続きご利用いただけます。"},{question:"本当にRork Maxから完全なアプリをiPhoneに入れられますか？",answer:"はい、本当です。作ったアプリは本物のiOSアプリとしてホーム画面に並び、ウィジェット、カメラ、Dynamic Islandなどのネイティブ機能もすぐに試せます。"},{question:"Webプロジェクトもプレビューできますか？",answer:"はい。Rork MaxではネイティブSwiftアプリとWebプロジェクトの両方をプレビューできます。Swiftアプリはネイティブで動作し、ホーム画面にインストールできるため、ウィジェット、Live Activities、ARKit、HealthKitなどのApple機能を利用できます。"},{question:"スマホからApp Storeに公開できますか？",answer:"はい。アイコン、スクリーンショット、審査前チェック、TestFlight、App Store申請まで、すべてチャットから完結します。"},{question:"アップデートはどうなりますか？",answer:"Rork Maxは自動でOTAアップデートされます。一度インストールすれば、次にアプリを開いたときに新機能が届きます。ケーブルも再インストールも不要です。"},{question:"iPhoneに複数のRork Maxアプリが表示されるのはなぜですか？",answer:"インストールは署名に使ったApple Developerチームに紐づくため、異なるAppleアカウントやチームでインストールすると、それぞれ別のアプリとして表示されます。同じRorkアカウントと同じAppleチームで再インストールすれば、新しいコピーは増えず既存のアプリが置き換えられます。使わないコピーは削除して大丈夫です。無料のApple Developerアカウントでは同時に3つまでという制限がある点にご注意ください。"},{question:"AppleからSMS確認コードが届きません",answer:(0,t.jsxs)(t.Fragment,{children:["SMSを待つ代わりに、サインイン済みのiPhone・iPad・Macから直接コードを取得できます：設定 → 自分の名前 → サインインとセキュリティ → 確認コードを入手。詳しい手順はAppleの",(0,t.jsx)(d,{href:n,children:"確認コードガイド"}),"をご覧ください。それでも解決しない場合は",(0,t.jsx)(d,{href:s,children:"Apple Accountのサポート"}),"にお問い合わせください。SMSの配信はApple側で管理されています。"]})},{question:"インストールしたのにアプリが起動しません",answer:(0,t.jsxs)(t.Fragment,{children:["2つ確認してください。まず、iPhoneでデベロッパを信頼します：設定 → 一般 → VPNとデバイス管理 → 自分のアカウント → 信頼。次に、デベロッパモードが有効か確認します：設定 → プライバシーとセキュリティ → デベロッパモード。無料のApple Developerアカウントは同時にインストールできるアプリが3つまでなので、 上限に達している可能性もあります。有料の",(0,t.jsx)(d,{href:o,children:"Apple Developer Program"}),"（年間99ドル）で解除できます。"]})},{question:"インストール後はどう使えばいいですか？",answer:"思い立ったらいつでもRork Maxを開いてください。すべてのアプリとセッション、最新の状態がそこにあります。"}]}};e.s(["FAQSection",0,function({locale:e}){let i=c[e],[n,s]=(0,r.useState)(!1),o=n?i.items:i.items.slice(0,5);return(0,t.jsx)("section",{className:"px-4 pb-10 pt-20 md:py-28",children:(0,t.jsxs)("div",{className:"mx-auto max-w-[720px]",children:[(0,t.jsx)("h2",{className:"text-3xl md:text-5xl font-bold tracking-[-0.03em] leading-[1.05]",children:i.title}),(0,t.jsx)("div",{className:"mt-8 flex flex-col md:mt-12",children:o.map(e=>(0,t.jsxs)("details",{className:"group border-b border-white/[0.07]",children:[(0,t.jsxs)("summary",{className:"flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left [&::-webkit-details-marker]:hidden",children:[(0,t.jsx)("span",{className:"text-[15px] font-medium tracking-[-0.01em] text-white/80 transition-colors group-hover:text-white group-open:text-white md:text-[17px] motion-reduce:transition-none",children:e.question}),(0,t.jsx)("span",{"aria-hidden":"true",className:"icon-[lucide--plus] size-4 shrink-0 text-white/35 transition-transform duration-200 group-open:rotate-45 motion-reduce:transition-none"})]}),(0,t.jsx)("p",{className:"pb-5 pr-8 text-[14px] leading-relaxed text-white/45 md:text-[15px]",children:e.answer})]},e.question))}),!n&&i.items.length>5&&(0,t.jsxs)("button",{type:"button",onClick:()=>s(!0),className:"mt-6 flex items-center gap-1.5 text-[14px] text-white/45 transition-colors hover:text-white md:text-[15px] motion-reduce:transition-none",children:[i.seeMore,(0,t.jsx)("span",{"aria-hidden":"true",className:"icon-[lucide--chevron-down] size-4"})]})]})})}])}]);

