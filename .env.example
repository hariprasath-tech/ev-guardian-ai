# SafeCell AI Platform Environment Configuration Example
# Copy this file to .env and update values accordingly

# Backend API Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256

# Hardware & ESP32 Configuration
ESP32_IP=10.242.93.137
MQTT_BROKER=10.242.93.137
MQTT_PORT=1883

# Frontend (Next.js) Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
